rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // নিচের ইমেইলে 01989923281 এর জায়গায় আপনার অ্যাডমিন আইডি নাম্বার (ইংরেজি সংখ্যায়) বসান
    function isAdmin() {
      return request.auth != null && request.auth.token.email == '01989923281@ms-studio.app';
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','phone','status','createdAt'])
        && (isAdmin() || request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }
  }
}
